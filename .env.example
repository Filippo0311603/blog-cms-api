# Copy to .env to customise. Every variable is optional.

NODE_ENV=development
PORT=3000

# Leave empty in development to use an automatic in-memory MongoDB (data is NOT persisted).
# With docker compose:  MONGODB_URI=mongodb://localhost:27017/blogcms
MONGODB_URI=

# Bearer token protecting /api/v1/cms/*. The value below is the documented test token.
CMS_API_TOKEN=brianfox-cms-token

# Max JSON body size, CORS origin ("*" or a comma-separated allow-list) and log level.
BODY_LIMIT=100kb
CORS_ORIGIN=*
LOG_LEVEL=info

# Rate limiting (per client IP, fixed window; public reader routes and CMS routes are counted apart).
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_PUBLIC_MAX=120
RATE_LIMIT_CMS_MAX=300

# Cache-Control max-age (seconds) of public GETs. 0 = `public, no-cache`: clients revalidate
# every time (cheap 304 via ETag), so changes show up immediately.
PUBLIC_CACHE_MAX_AGE=0

# Behind a reverse proxy/load balancer: number of proxy hops (e.g. 1), or true/false, or a
# comma-separated list of trusted addresses. Needed for per-client rate limits and logs.
TRUST_PROXY=false
